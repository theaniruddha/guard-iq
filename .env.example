# Ollama Cloud (synthesis / orchestrator — Nemotron Super/Nano)
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=your-ollama-cloud-key

# Groq (fast chat / sub-agents)
GROQ_API_KEY=your-groq-key

# Logfire observability
LOGFIRE_TOKEN=your-logfire-token

# Optional: override per-role models (provider:model)
# GC_MODEL_ORCHESTRATOR=ollama:nemotron-3-super:cloud
# GC_MODEL_SYNTHESIS=ollama:nemotron-3-super:cloud
# GC_MODEL_REDTEAM=ollama:nemotron-3-nano:cloud
# GC_MODEL_CHAT=groq:llama-3.3-70b-versatile
# GC_MODEL_SUB_AGENT=ollama:nemotron-3-nano:cloud

# Engine sidecar (optional)
GC_CONTRACT_PATH=policies/food_service.v1.yaml
GC_ENGINE_HOST=0.0.0.0
GC_ENGINE_PORT=8080